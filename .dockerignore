# Copy only what the image needs to build and run the server, so local files never get in:
# leave everything out, then let the needed files back in
*
!src/
!pyproject.toml
!uv.lock
!README.md
!LICENSE.txt
!.python-version

# Leave out the Python cache files inside src/ again; a pattern without **/ matches only in the top folder
**/__pycache__/
**/*.pyc
**/*.pyo
**/.DS_Store

# .git/ is left out too, so hatch-vcs cannot read tags: the Dockerfile sets SETUPTOOLS_SCM_PRETEND_VERSION
# from the BUILD_VERSION build-arg instead
